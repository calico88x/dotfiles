# ~/.bashrc
#
# Portable interactive Bash configuration for development containers.
# Managed by chezmoi.

# ---------------------------------------------------------------------------
# Interactive shells only
# ---------------------------------------------------------------------------

case $- in
    *i*) ;;
      *) return ;;
esac


# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------

# Personal executables installed by chezmoi/mise.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac


# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------

# Ignore duplicate commands and commands beginning with a space.
HISTCONTROL=ignoreboth:erasedups

# Append history instead of overwriting it when the shell exits.
shopt -s histappend

HISTSIZE=5000
HISTFILESIZE=10000


# ---------------------------------------------------------------------------
# Shell behavior
# ---------------------------------------------------------------------------

# Update terminal dimensions after each command.
shopt -s checkwinsize

# Use vi-style command-line editing.
set -o vi

# ---------------------------------------------------------------------------
# Prompt
# ---------------------------------------------------------------------------

# Compact development prompt:
#
#   vscode ➜ /workspaces/project (main) $
#
# - green username
# - red arrow when the previous command failed
# - blue working directory
# - colored Git branch when inside a repository

__set_prompt() {
    local exit_code=$?
    local branch=""
    local git_part=""
    local arrow_color='\[\033[0m\]'

    if (( exit_code != 0 )); then
        arrow_color='\[\033[1;31m\]'
    fi

    branch="$(
        git --no-optional-locks symbolic-ref --short HEAD 2>/dev/null ||
        git --no-optional-locks rev-parse --short HEAD 2>/dev/null
    )"

    if [[ -n "$branch" ]]; then
        git_part=" \[\033[0;36m\](\[\033[1;31m\]${branch}\[\033[0;36m\])"
    fi

    PS1="\[\033[0;32m\]\u ${arrow_color}➜ \[\033[1;34m\]\w${git_part}\[\033[0m\] \$ "
}

PROMPT_COMMAND="__set_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------

if command -v dircolors >/dev/null 2>&1; then
    eval "$(dircolors -b)"

    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi


# ---------------------------------------------------------------------------
# Bash completion
# ---------------------------------------------------------------------------

if ! shopt -oq posix; then
    if [ -r /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -r /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi


# ---------------------------------------------------------------------------
# User aliases
# ---------------------------------------------------------------------------

if [ -r "$HOME/.bash_aliases" ]; then
    . "$HOME/.bash_aliases"
fi


# ---------------------------------------------------------------------------
# mise
# ---------------------------------------------------------------------------

# mise is bootstrapped by chezmoi into ~/.local/bin.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi
