# ~/.bashrc
#
# Portable interactive Bash configuration for development containers.
# Managed by chezmoi.

# ---------------------------------------------------------------------------
# Interactive shells only
# ---------------------------------------------------------------------------

case $- in
    *i*) ;;
      *) return ;;
esac


# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------

# Personal executables installed by chezmoi/mise.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac


# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------

# Ignore duplicate commands and commands beginning with a space.
HISTCONTROL=ignoreboth:erasedups

# Append history instead of overwriting it when the shell exits.
shopt -s histappend

HISTSIZE=5000
HISTFILESIZE=10000


# ---------------------------------------------------------------------------
# Shell behavior
# ---------------------------------------------------------------------------

# Update terminal dimensions after each command.
shopt -s checkwinsize

# Use vi-style command-line editing.
set -o vi


# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------

if command -v dircolors >/dev/null 2>&1; then
    eval "$(dircolors -b)"

    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi


# ---------------------------------------------------------------------------
# Bash completion
# ---------------------------------------------------------------------------

if ! shopt -oq posix; then
    if [ -r /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -r /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi


# ---------------------------------------------------------------------------
# User aliases
# ---------------------------------------------------------------------------

if [ -r "$HOME/.bash_aliases" ]; then
    . "$HOME/.bash_aliases"
fi


# ---------------------------------------------------------------------------
# mise
# ---------------------------------------------------------------------------

# mise is bootstrapped by chezmoi into ~/.local/bin.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi
